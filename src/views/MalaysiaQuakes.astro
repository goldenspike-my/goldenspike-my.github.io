---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { t, url, type Lang } from '../lib/i18n';
import { getQuakeHistory, HISTORY_START, HISTORY_MIN_MAG } from '../lib/quake-history';
import data from '../data/malaysia-events.json';
interface Props { lang: Lang }
const { lang } = Astro.props;

// 说明文字放在 src/content/pages/malaysia-quakes-zh.md / -en.md（Pages CMS 可以改）
const page = await getEntry('pages', `malaysia-quakes-${lang}`);
const Content = page ? (await render(page)).Content : null;

const history = await getQuakeHistory();
type Ev = (typeof data.events)[number] & { lat?: number; lon?: number };
const events = [...(data.events as Ev[])].sort((a, b) => b.date.localeCompare(a.date));   // 最新的在上面
const link = (l: string) => (l.startsWith('/') ? url(lang, l) : l);
const clientEvents = events.filter((e) => e.lat != null).map((e) => ({
  id: e.id, lat: e.lat, lon: e.lon, mag: e.mag, title: e.title[lang], date: e.dateText[lang],
}));
---
<Base lang={lang} title={t(lang, 'myTitle')} description={t(lang, 'myLead')} active="monitor">
  <section class="sec-darker my-page">
    <div class="wrap">
      <nav class="tabs" aria-label={t(lang, 'monitor')}>
        <a class="chip" href={url(lang, '/monitor')}>{t(lang, 'monitorTabLive')}</a>
        <a class="chip active" href={url(lang, '/malaysia-quakes')} aria-current="page">{t(lang, 'monitorTabMalaysia')}</a>
      </nav>
      <div class="top">
        <div>
          <span class="kicker">{t(lang, 'myKicker')}</span>
          <h1 class="page-title">{t(lang, 'myTitle')}</h1>
          <p class="sub">{t(lang, 'myLead')}</p>
        </div>
        <div class="chips" role="group" aria-label="Layer" id="layer-chips">
          <button class="chip" type="button" data-layer="history" aria-pressed="true">{t(lang, 'myHistory')}</button>
          <button class="chip" type="button" data-layer="recent" aria-pressed="false">{t(lang, 'myRecent')}</button>
        </div>
      </div>

      <div class="panel" id="my" data-lang={lang} data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}
        data-depth={t(lang, 'depth')} data-loading={t(lang, 'loading')} data-error={t(lang, 'loadError')} data-empty={t(lang, 'noQuakes')}
        data-hist-count={t(lang, 'myCountHist')} data-recent-count={t(lang, 'quakesCount')}>
        <div class="map-box">
          <div id="map" role="region" aria-label={t(lang, 'myTitle')}></div>
          <p class="map-count" id="map-count" aria-live="polite"></p>
        </div>
        <div class="list-box">
          <h2 class="list-title">{t(lang, 'myEvents')}</h2>
          <ol class="events">
            {events.map((e) => (
              <li class="ev" id={`ev-${e.id}`}>
                <button type="button" class="ev-head" data-id={e.id} disabled={e.lat == null}>
                  <span class="ev-mag">{e.mag}</span>
                  <span class="ev-main"><span class="ev-title">{e.title[lang]}</span><span class="ev-date">{e.dateText[lang]}</span></span>
                </button>
                <p class="ev-text">{e.text[lang]}</p>
                <p class="ev-foot"><a href={link(e.link)} {...(e.link.startsWith('/') ? {} : { target: '_blank', rel: 'noopener' })}>{e.link.startsWith('/') ? t(lang, 'myReadMore') : 'USGS ↗'}</a><span>{e.source}</span></p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="legend" aria-label={t(lang, 'depth')}>
        <span><i style="background:#F2B90D"></i>{t(lang, 'depthShallow')}</span>
        <span><i style="background:#FF8A1F"></i>{t(lang, 'depthMid')}</span>
        <span><i style="background:#FF4D2E"></i>{t(lang, 'depthDeep')}</span>
        <span><i class="ring"></i>{t(lang, 'myEvents')}</span>
        <span class="plate"><i></i>{t(lang, 'plateBoundary')}</span>
      </div>
      <div class="legend mags" aria-label={t(lang, 'myMagScale')}>
        <span class="mags-title">{t(lang, 'myMagScale')}</span>
        {[[5, 5], [6, 8], [7, 16], [8, 23]].map(([m, d]) => (
          <span class="mag"><i style={`width:${d}px;height:${d}px`}></i>M{m}</span>
        ))}
      </div>
      <p class="note">{t(lang, 'myHistNote')}</p>
      <script type="application/json" id="my-data" set:html={JSON.stringify({ history, events: clientEvents, start: HISTORY_START, minMag: HISTORY_MIN_MAG })}></script>
    </div>
  </section>

  {Content && (
    <section class="sec-light">
      <div class="wrap prose-wrap"><article class="prose"><Content /></article></div>
    </section>
  )}
</Base>


<style>
  .my-page { padding: 40px 0 72px; --ring: #F5F1E8; }   /* 值得记住的地震：白圈，跟金色的浅层地震分开 */
  .tabs { display: flex; gap: 8px; margin-bottom: 22px; flex-wrap: wrap; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 28px; }
  .top h1 { margin-top: 10px; }
  .sub { color: var(--muted); margin: 10px 0 0; max-width: 640px; font-size: 17px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .panel { display: flex; flex-wrap: wrap; gap: 20px; }
  .map-box { position: relative; flex: 3 1 560px; min-width: 0; border-radius: 14px; background: #0C0A06; }   /* 圆角外框在 global.css 的 .map-box::after */
  #map { height: clamp(420px, 68vh, 660px); }
  .map-count { position: absolute; left: 12px; top: 10px; margin: 0; padding: 6px 12px; border-radius: 8px; background: rgba(19,16,8,.85); font-size: 13px; color: var(--muted); pointer-events: none; }
  .list-box { flex: 1 1 320px; min-width: 0; background: var(--dark); border: 1px solid var(--line); border-radius: 14px; padding: 16px; max-height: clamp(420px, 68vh, 660px); overflow-y: auto; }
  .list-title { margin: 0 0 12px; font-size: 18px; }
  .events { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ev { background: var(--dark-card); border: 1px solid var(--dark-border); border-radius: 10px; padding: 12px 14px; }
  .ev.on { border-color: var(--ring); box-shadow: 0 0 0 1px var(--ring); }
  .ev-head { display: flex; gap: 12px; align-items: center; width: 100%; background: none; border: 0; padding: 0; color: inherit; text-align: left; min-height: 44px; }
  .ev-head:disabled { cursor: default; }
  .ev-mag { flex: none; min-width: 64px; padding: 5px 6px; border-radius: 8px; border: 1px solid var(--gold); color: var(--gold); font-weight: 700; font-size: 13px; text-align: center; }
  .ev-main { display: flex; flex-direction: column; }
  .ev-title { font-weight: 700; }
  .ev-date { font-size: 13px; color: var(--muted); }
  .ev-text { margin: 10px 0 8px; font-size: 14px; color: var(--dark-text); }
  .ev-foot { display: flex; flex-wrap: wrap; gap: 4px 12px; justify-content: space-between; margin: 0; font-size: 12px; color: var(--muted); }
  .ev-foot a { font-weight: 700; font-size: 13px; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 16px; font-size: 13px; color: var(--muted); align-items: center; }
  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; }
  .legend i.ring { background: none; border: 2px solid var(--ring); width: 14px; height: 14px; }
  .legend.mags { margin-top: 8px; gap: 8px 16px; }
  .mags-title { font-weight: 700; }
  .legend .mag { display: inline-flex; align-items: center; }
  .legend .mag i { flex: none; margin-right: 6px; background: #8A7A52; border: 1px solid #0C0A06; vertical-align: middle; }
  .legend .plate i { border-radius: 0; height: 0; width: 18px; border-top: 2px dashed var(--cyan); background: none; vertical-align: 3px; }
  .note { margin: 10px 0 0; font-size: 13px; color: var(--muted); max-width: 820px; }
  .prose-wrap { padding: 64px 24px 88px; }
  .prose { max-width: 760px; margin: 0 auto; color: var(--paper-body); font-size: 17px; line-height: 1.8; }
  .prose :global(h2) { font-size: 26px; margin: 44px 0 12px; color: var(--paper-text); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; margin: 16px 0; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid var(--paper-border); padding: 8px 10px; text-align: left; }
  .prose :global(th) { color: var(--paper-text); }
  .prose :global(blockquote) { margin: 20px 0; padding: 12px 18px; border-left: 4px solid var(--gold); background: #FBF7EC; }
</style>

<script>
  import { createMap, addPlates, maplibregl, escapeHtml, firstSymbolLayer } from '../lib/map';
  import type { HistQuake } from '../lib/quake-history';

  const root = document.getElementById('my')!;
  const ds = root.dataset as Record<string, string>;
  const lang = ds.lang;
  const locale = lang === 'zh' ? 'zh-CN' : 'en-GB';
  const D = JSON.parse(document.getElementById('my-data')!.textContent || '{}') as {
    history: HistQuake[]; events: { id: string; lat: number; lon: number; mag: string; title: string; date: string }[]; start: string; minMag: number;
  };
  const countEl = document.getElementById('map-count')!;
  const BOUNDS: [[number, number], [number, number]] = [[93, -7], [121, 9]];   // 苏门答腊到沙巴
  const depthColor: any = ['step', ['get', 'depth'], '#F2B90D', 70, '#FF8A1F', 300, '#FF4D2E'];

  const histFC = {
    type: 'FeatureCollection',
    features: D.history.map(([lon, lat, depth, mag, year]) => ({ type: 'Feature', geometry: { type: 'Point', coordinates: [lon, lat] }, properties: { depth, mag, year } })),
  };
  const evFC = {
    type: 'FeatureCollection',
    features: D.events.map((e) => ({ type: 'Feature', geometry: { type: 'Point', coordinates: [e.lon, e.lat] }, properties: { id: e.id, label: e.title } })),
  };

  let recentLoaded: Promise<any> | undefined;
  async function fetchRecent() {
    const since = new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10);
    const q = `https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&minlatitude=-7&maxlatitude=9&minlongitude=93&maxlongitude=121&minmagnitude=2.5&starttime=${since}`;
    const res = await fetch(q);
    if (!res.ok) throw new Error(`USGS ${res.status}`);
    const j = await res.json();
    return {
      type: 'FeatureCollection',
      features: (j.features as any[]).map((f) => ({ type: 'Feature', geometry: { type: 'Point', coordinates: [f.geometry.coordinates[0], f.geometry.coordinates[1]] },
        properties: { depth: f.geometry.coordinates[2], mag: f.properties.mag ?? 0, place: f.properties.place, time: f.properties.time, url: f.properties.url } })),
    };
  }

  createMap({ container: 'map', lang, bounds: BOUNDS, minZoom: 3, maxZoom: 11 }).then(async (map) => {
    await addPlates(map, ds.base, 0.7).catch(() => {});
    const below = firstSymbolLayer(map);
    const circle = (id: string, source: string, visible: boolean) => map.addLayer({
      id, type: 'circle', source,
      layout: { visibility: visible ? 'visible' : 'none', 'circle-sort-key': ['get', 'mag'] },
      paint: {
        'circle-radius': ['interpolate', ['linear'], ['get', 'mag'], 2.5, 2.5, 5, 2.4, 6, 4, 7, 8, 9, 15],
        'circle-color': depthColor, 'circle-opacity': 0.72, 'circle-stroke-color': '#0C0A06', 'circle-stroke-width': 0.6,
      },
    }, below);
    map.addSource('hist', { type: 'geojson', data: histFC as any, attribution: 'Earthquakes: USGS ComCat' });
    circle('hist', 'hist', true);
    map.addSource('recent', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    circle('recent', 'recent', false);
    // 值得记住的地震：白色圆圈 + 名字（金色已经用来表示浅层地震）
    const RING = '#F5F1E8';
    map.addSource('ev', { type: 'geojson', data: evFC as any });
    map.addLayer({ id: 'ev-ring', type: 'circle', source: 'ev', paint: {
      'circle-radius': ['case', ['boolean', ['feature-state', 'on'], false], 14, 10], 'circle-color': 'rgba(0,0,0,0)',
      'circle-stroke-color': RING, 'circle-stroke-width': ['case', ['boolean', ['feature-state', 'on'], false], 3, 2],
    } });
    map.addLayer({ id: 'ev-label', type: 'symbol', source: 'ev', layout: {
      'text-field': ['get', 'label'], 'text-font': ['Noto Sans Bold'], 'text-size': 12, 'text-offset': [0, 1.4], 'text-anchor': 'top', 'text-optional': true,
    }, paint: { 'text-color': RING, 'text-halo-color': '#0C0A06', 'text-halo-width': 1.6 } });

    const showCount = (layer: string, n: number) => {
      countEl.textContent = layer === 'hist' ? `${n} ${ds.histCount}` : `${n} ${ds.recentCount}`;
    };
    showCount('hist', histFC.features.length);

    const popup = new maplibregl.Popup({ maxWidth: '260px' });
    for (const layer of ['hist', 'recent']) {
      map.on('click', layer, (e) => {
        const p = e.features![0].properties as any;
        const when = layer === 'hist' ? String(p.year) : new Date(p.time).toLocaleString(locale, { timeZoneName: 'short' });
        popup.setLngLat((e.features![0].geometry as any).coordinates).setHTML(
          `<strong>M${Number(p.mag).toFixed(1)}</strong> · ${when}<br>${ds.depth} ${Math.round(p.depth)} km${p.place ? `<br>${escapeHtml(p.place)}` : ''}${p.url ? `<br><a href="${escapeHtml(p.url)}" target="_blank" rel="noopener">USGS ↗</a>` : ''}`,
        ).addTo(map);
      });
      map.on('mouseenter', layer, () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', layer, () => { map.getCanvas().style.cursor = ''; });
    }

    // 点右边的事件 → 地图飞过去；点地图上的白圈 → 右边对应的卡片亮起来
    let onId: string | null = null;
    const evIndex = new Map(evFC.features.map((f, i) => [f.properties.id, i]));
    function select(id: string, fly: boolean) {
      if (onId != null) map.setFeatureState({ source: 'ev', id: evIndex.get(onId)! }, { on: false });
      document.querySelectorAll('.ev.on').forEach((x) => x.classList.remove('on'));
      onId = id;
      map.setFeatureState({ source: 'ev', id: evIndex.get(id)! }, { on: true });
      const card = document.getElementById(`ev-${id}`);
      card?.classList.add('on');
      if (fly) {
        const f = evFC.features[evIndex.get(id)!];
        map.flyTo({ center: f.geometry.coordinates as [number, number], zoom: 6.5, duration: 1400 });
      } else card?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
    // geojson 要有 feature id 才能用 feature-state
    (map.getSource('ev') as any).setData({ ...evFC, features: evFC.features.map((f, i) => ({ ...f, id: i })) });
    document.querySelectorAll<HTMLButtonElement>('.ev-head').forEach((b) => b.addEventListener('click', () => select(b.dataset.id!, true)));
    map.on('click', 'ev-ring', (e) => select((e.features![0].properties as any).id, false));
    map.on('mouseenter', 'ev-ring', () => { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'ev-ring', () => { map.getCanvas().style.cursor = ''; });

    const chips = document.querySelectorAll<HTMLButtonElement>('#layer-chips .chip');
    chips.forEach((c) => c.addEventListener('click', async () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      const recent = c.dataset.layer === 'recent';
      map.setLayoutProperty('hist', 'visibility', recent ? 'none' : 'visible');
      map.setLayoutProperty('recent', 'visibility', recent ? 'visible' : 'none');
      if (!recent) { showCount('hist', histFC.features.length); return; }
      countEl.textContent = ds.loading;
      try {
        recentLoaded ??= fetchRecent();
        const fc = await recentLoaded;
        (map.getSource('recent') as any).setData(fc);
        countEl.textContent = fc.features.length ? `${fc.features.length} ${ds.recentCount}` : ds.empty;
      } catch {
        recentLoaded = undefined;
        countEl.textContent = ds.error;
      }
    }));
  });
</script>
