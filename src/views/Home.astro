---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import PostCard from '../components/PostCard.astro';
import QuakeList from '../components/QuakeList.astro';
import site from '../data/site.json';
import facts from '../data/facts.json';
import gssps from '../data/gssps.json';
import { getVideos } from '../lib/videos';
import { getPostsForLang } from '../lib/posts';
import { tracePath } from '../lib/trace';
import { getRealTrace, envelopePath } from '../lib/seismogram';
import { slugOf } from '../lib/twins';
import { t, url, asset, type Lang } from '../lib/i18n';
import { getEntry } from 'astro:content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const videos = (await getVideos()).filter((v) => v.format !== 'short').slice(0, 4);   // shorts live on the videos page
const [featured, ...moreVideos] = videos;
const { posts, fallback } = await getPostsForLang(lang);
// 「关于我」卡片的照片 = 关于页上传的照片（Pages CMS → 关于我）
const aboutPhoto = (await getEntry('pages', `about-${lang}`))?.data.photo;
const latestPosts = posts.slice(0, 3);
// 首页大图：只从文章「首页大图」栏位（heroImage，Pages CMS 里挑的真实岩石／野外照片）随机挑；
// 示意图、人像、有字的缩略图不会跑进来。一张都没挑的话，才退回用文章封面
const toHero = (p: (typeof posts)[number], src: string, alt?: string) =>
  ({ src: asset(src), alt: alt || p.data.title, title: p.data.title, href: url(p.data.lang, `/blog/${slugOf(p)}`) });
const picked = posts.filter((p) => p.data.heroImage).map((p) => toHero(p, p.data.heroImage!, p.data.heroImageAlt));
const heroPool = picked.length ? picked
  : posts.filter((p) => p.data.cover).slice(0, 1).map((p) => toHero(p, p.data.cover!, p.data.coverAlt));
// 地层带的波形：网站生成时抓到的真实地震记录；抓不到就用示意波形
const real = await getRealTrace();
const traceNote = real
  ? t(lang, 'traceReal').replace('{sta}', `${real.net}.${real.sta}`).replace('{site}', real.site).replace('{dist}', String(real.dist))
  : t(lang, 'traceNote');
// 「全世界的金钉子」那一条：数字在网站生成时算好
const spikeCount = gssps.gssps.length;
const spikeCountries = new Set(gssps.gssps.map((g) => g.country)).size;
const icons: Record<string, string> = {
  question: 'M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01',
  wave: 'M2 12h3l2-6 4 12 3-9 2 3h6',
  water: 'M3 18c3-2 6-2 9 0s6 2 9 0M3 13c3-2 6-2 9 0s6 2 9 0',
};
---
<Base lang={lang} active="home">
  <!-- 首页大图：左边文字，右边真的标本照片；底下的地层带画着最新地震的示意波形 -->
  <section class="hero sec-darker">
    <div class="hero-inner wrap">
      <div class="hero-text">
        <span class="kicker rise" style="--d:0">{t(lang, 'heroKicker')}</span>
        <h1 class="rise" style="--d:1">{lang === 'zh' ? site.heroTitle : site.heroTitleEn}<em>{site.heroTagline}</em></h1>
        <p class="rise" style="--d:2">{lang === 'zh' ? site.heroText : site.heroTextEn}</p>
        <div class="hero-btns rise" style="--d:3">
          <a class="btn btn-gold" href={site.youtubeUrl}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor"/></svg>
            {t(lang, 'subscribe')}
          </a>
          <a class="btn btn-ghost" href={url(lang, '/blog')}>{t(lang, 'readBlog')} →</a>
        </div>
      </div>
      {heroPool.length > 0 && (
        <a class="specimen" id="hero-pick" href={heroPool[0].href}>
          <span class="frame">
            <img id="hero-img" alt="" width="1080" height="1080" fetchpriority="high" data-pool={JSON.stringify(heroPool)} />
            <noscript><img src={heroPool[0].src} alt={heroPool[0].alt} width="1080" height="1080" /></noscript>
          </span>
          <span class="specimen-label">
            <span class="sl-kick">{t(lang, 'fromBlog')}</span>
            <span class="sl-cap" id="hero-cap">{heroPool[0].title}</span>
            <span class="sl-go">{t(lang, 'readMore')} →</span>
          </span>
        </a>
      )}
      {/* 马上挑一张（在图片开始下载前），避免先闪过别的照片；尽量不跟上次一样 */}
      <script is:inline>
        (function () {
          var img = document.getElementById('hero-img'); if (!img) return;
          var pool = JSON.parse(img.dataset.pool || '[]'); if (!pool.length) return;
          var last = -1; try { last = +localStorage.getItem('gs-hero'); } catch (e) {}
          var i = Math.floor(Math.random() * pool.length);
          if (pool.length > 1 && i === last) i = (i + 1 + Math.floor(Math.random() * (pool.length - 1))) % pool.length;
          try { localStorage.setItem('gs-hero', String(i)); } catch (e) {}
          var p = pool[i];
          img.src = p.src; img.alt = p.alt;
          document.getElementById('hero-pick').href = p.href;
          document.getElementById('hero-cap').textContent = p.title;
        })();
      </script>
    </div>

    <!-- 地层带 + 地震波形；说明文字放在波形底下，跟上面的大图分开 -->
    <figure class="seis-fig">
    <div class="seis">
    <div class="strata" aria-hidden="true">
      <div style="flex-grow:18;background:var(--stratum-1)"></div>
      <div style="flex-grow:9;background:var(--stratum-2)"></div>
      <div style="flex-grow:5;background:var(--stratum-3)"></div>
      <div style="flex-grow:1.5;background:var(--stratum-4)"></div>
      <div style="flex-grow:12;background:var(--stratum-5)"></div>
      <div style="flex-grow:7;background:var(--stratum-6)"></div>
      <div style="flex-grow:14;background:var(--stratum-7)"></div>
    </div>
    <svg class="trace" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
      <path id="trace-path" d={real ? envelopePath(real.env) : tracePath(5)} />
    </svg>
    <span class="pen" aria-hidden="true"></span>
    {real && <span class="pmark" style={`--x:${(real.p * 100).toFixed(2)}%;--p:${real.p.toFixed(3)}`} aria-hidden="true">{t(lang, 'pMark')}</span>}
    </div>
    <figcaption class="wrap seis-cap">
      <a class="quake-chip" id="quake-chip" href={url(lang, '/monitor')} hidden
         data-real={real ? JSON.stringify({ mag: real.mag, place: real.place, time: real.time }) : undefined}>
        <span class="dot" aria-hidden="true"></span>
        <span>{t(lang, 'latestQuake')}</span>
        <strong id="qc-mag"></strong>
        <span class="qc-place" id="qc-place"></span>
      </a>
      <span class="qc-note">{traceNote}{real && ` · ${t(lang, 'pEstimate')}`}</span>
    </figcaption>
    </figure>
  </section>

  <!-- 最新视频（深色）：最新一集放大，其他三集排在旁边 -->
  <section class="section sec-dark">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <div><h2>{t(lang, 'latestVideos')}</h2><p>{t(lang, 'latestVideosSub')}</p></div>
        <a href={url(lang, '/videos')}>{t(lang, 'videos')} →</a>
      </div>
      {featured && (
        <div class="vfeature" data-reveal style="--i:1">
          <VideoCard video={featured} lang={lang} size="feature" label={t(lang, 'latestEpisode')} />
          <div class="vmore">{moreVideos.map((v) => <VideoCard video={v} lang={lang} size="compact" />)}</div>
        </div>
      )}
    </div>
  </section>

  <!-- 博客（浅色）：首页用纯文字卡，不重复上面视频的缩略图 -->
  <section class="section sec-light">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <div><h2>{t(lang, 'blog')}</h2><p>{t(lang, 'blogSub')}</p></div>
        <a href={url(lang, '/blog')}>{t(lang, 'seeAllPosts')} →</a>
      </div>
      {fallback && <p class="note">{t(lang, 'enFallback')}</p>}
      {latestPosts.length
        ? <div class="grid-wide">{latestPosts.map((p, i) => <div class="rv" data-reveal style={`--i:${i + 1}`}><PostCard post={p} lang={lang} variant="text" /></div>)}</div>
        : <p class="note">{t(lang, 'noPosts')}</p>}
    </div>
  </section>

  <!-- 全世界的金钉子（深色）：频道名字的由来，带去金钉子地图 -->
  <section class="section sec-dark spikes-band">
    <div class="wrap spikes-inner">
      <div class="spikes-text" data-reveal>
        <span class="kicker">{t(lang, 'homeSpikesKicker')}</span>
        <h2>{t(lang, 'homeSpikesTitle').replace('{n}', String(spikeCount))}</h2>
        <p>{t(lang, 'homeSpikesText').replace('{c}', String(spikeCountries))}</p>
        <a class="btn btn-gold" href={url(lang, '/golden-spikes')}>{t(lang, 'homeSpikesCta')} →</a>
      </div>
      <a class="spikes-map" href={url(lang, '/golden-spikes')} data-reveal style="--i:1" tabindex="-1">
        <img src={asset('golden-spikes-map.svg')} alt={t(lang, 'homeSpikesAlt')} width="720" height="300" loading="lazy" />
      </a>
    </div>
  </section>
  <!-- 地震监测预告（更深色） -->
  <section class="section sec-darker monitor">
    <div class="wrap monitor-inner">
      <div class="monitor-text" data-reveal>
        <span class="kicker live">{t(lang, 'monitorKicker')}</span>
        <h2>{t(lang, 'monitorTitle')}</h2>
        <p>{t(lang, 'monitorText')}</p>
        <a class="btn btn-gold" href={url(lang, '/monitor')}>{t(lang, 'openMonitor')} →</a>
      </div>
      <div class="monitor-list reveal-list"><QuakeList lang={lang} limit={6} /></div>
    </div>
  </section>

  <!-- 你知道吗（浅色）：卡片做成标本标签的样子 -->
  <section class="section sec-light">
    <div class="wrap center">
      <h2 class="page-title" data-reveal>{t(lang, 'dyk')}</h2>
      <div class="flip-grid">
        {facts.facts.map((f, i) => (
          <button class="flip" type="button" aria-pressed="false" data-reveal style={`--i:${i + 1}`}>
            <span class="face front">
              <span class="label-head">
                <span>{t(lang, 'questionCard')}</span>
                <span class="no">No. {String(i + 1).padStart(2, '0')}</span>
              </span>
              <span class="q">{lang === 'zh' ? f.question : f.questionEn}</span>
              <span class="label-foot">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                  {f.icon === 'question' && <circle cx="12" cy="12" r="9" />}
                  {f.icon === 'water' && <circle cx="12" cy="6" r="2.5" />}
                  <path d={icons[f.icon] ?? icons.question} />
                </svg>
                <span>{t(lang, 'dykSub')} ↻</span>
              </span>
            </span>
            <span class="face back">{lang === 'zh' ? f.answer : f.answerEn}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- 关于（浅色） -->
  <section class="sec-light about">
    <div class="wrap">
      <div class="about-card" data-reveal>
        {aboutPhoto
          ? <a class="avatar" href={url(lang, '/about')} tabindex="-1" aria-hidden="true"><img src={asset(aboutPhoto)} alt="" loading="lazy" /></a>
          : <div class="ph avatar" aria-hidden="true">GS</div>}
        <div>
          <h2>{t(lang, 'aboutTitle')}</h2>
          <p>{t(lang, 'homeAboutText')}</p>
          <a href={url(lang, '/about')}>{t(lang, 'readMore')} →</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; }
  .hero-inner { position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .85fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding-top: clamp(56px, 8vw, 96px); padding-bottom: 40px; }
  .hero-text { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .hero h1 { margin: 0; font-family: var(--font-serif); font-weight: 900; font-size: clamp(40px, 5.6vw, 76px); line-height: 1.1; color: #fff; text-wrap: balance; }
  .hero h1 em { display: block; color: var(--gold); font-weight: 700; font-size: .82em; margin-top: .12em; }
  .hero p { margin: 0; max-width: 560px; font-size: clamp(17px, 1.6vw, 19px); line-height: 1.85; color: #E5DCC3; text-wrap: pretty; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }

  /* 进场：文字一行行升上来 */
  .rise { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--d) * 110ms + 100ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } }

  /* 博客照片 + 博物馆标签；照片慢慢推近，滑鼠移过去会跟着微微倾斜 */
  .specimen { position: relative; display: block; text-decoration: none; perspective: 900px; animation: drop 1.1s cubic-bezier(.2,.7,.2,1) .35s both; }
  @keyframes drop { from { opacity: 0; transform: translateY(40px) rotate(6deg); } }
  .specimen:hover { opacity: 1; }
  .frame { position: relative; display: block; overflow: hidden; border-radius: 14px; border: 1px solid var(--dark-border); box-shadow: 0 30px 60px -20px rgba(0,0,0,.7); aspect-ratio: 1; background: #2D2414;
    transform: rotate(1.5deg) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg)); transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .specimen:hover .frame { transform: rotate(0deg) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg)) translateY(-4px); }
  .frame img { width: 100%; height: 100%; object-fit: cover; animation: kenburns 22s ease-in-out infinite alternate; }
  @keyframes kenburns { from { transform: scale(1.02); } to { transform: scale(1.14) translate(-2%, -1.5%); } }
  .frame::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at var(--gx, 50%) var(--gy, 30%), rgba(255,230,170,.18), transparent 55%); opacity: 0; transition: opacity .3s; pointer-events: none; }
  .specimen:hover .frame::after { opacity: 1; }
  .sl-kick { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .specimen-label { z-index: 2; transition: transform .35s cubic-bezier(.2,.7,.2,1); position: absolute; left: -18px; bottom: 28px; transform: rotate(-3deg); background: var(--paper); color: var(--paper-text); border-radius: 4px; padding: 12px 16px 10px; display: flex; flex-direction: column; gap: 4px; box-shadow: 0 10px 24px -8px rgba(0,0,0,.6); border-left: 4px solid var(--gold); max-width: 85%; }
  .sl-cap { font-family: var(--font-cjk-serif); font-weight: 700; font-size: 16px; line-height: 1.4; }
  .specimen:hover .specimen-label { transform: rotate(-1deg) translate(6px, -6px); }
  .sl-go { font-size: 13px; font-weight: 700; color: var(--gold-deep); }

  /* 地层带 + 示意波形 */
  .seis-fig { margin: 24px 0 0; }
  .seis { position: relative; height: 120px; }
  .strata { position: absolute; left: 0; right: 0; bottom: 0; height: 120px; display: flex; flex-direction: column; justify-content: flex-end; opacity: .6; }
  .strata > div { flex: 1 1 auto; transform-origin: left; animation: layer 1.2s cubic-bezier(.2,.7,.2,1) both; }
  .strata > div:nth-child(2) { animation-delay: .08s } .strata > div:nth-child(3) { animation-delay: .16s } .strata > div:nth-child(4) { animation-delay: .24s }
  .strata > div:nth-child(5) { animation-delay: .32s } .strata > div:nth-child(6) { animation-delay: .4s } .strata > div:nth-child(7) { animation-delay: .48s }
  @keyframes layer { from { transform: scaleX(0); } }
  .trace { position: absolute; left: 0; bottom: 0; width: 100%; height: 120px; overflow: visible; }
  .trace path { fill: none; stroke: var(--gold); stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  /* 由左往右「画」出来，像记录纸在走 */
  :global(html.js) .trace { clip-path: inset(0 100% 0 0); }
  .trace.draw { animation: draw 4.5s linear both; }
  @keyframes draw { to { clip-path: inset(0 0 0 0); } }
  /* 跟着画线走的「笔」，像滚筒记录纸 */
  .pen { position: absolute; bottom: 6px; left: 0; width: 2px; height: 104px; background: linear-gradient(transparent, var(--gold), transparent); opacity: 0; pointer-events: none; }
  .trace.draw ~ .pen { animation: pen 4.5s linear both; }
  @keyframes pen { 0% { left: 0; opacity: 1; } 96% { opacity: 1; } 100% { left: 100%; opacity: 0; } }
  /* P 波到达的位置：笔经过才出现 */
  .pmark { position: absolute; z-index: 1; left: var(--x); bottom: 64px; padding: 0 0 26px 6px; border-left: 1px dashed var(--cyan); font: italic 700 13px/1 var(--font-serif); color: var(--cyan); white-space: nowrap; opacity: 0; text-shadow: 0 0 3px #131008, 0 0 6px #131008, 0 1px 2px #000; }
  .pmark::before { content: ''; position: absolute; left: 2px; top: -4px; width: calc(100% + 4px); height: 21px; background: rgba(19,16,8,.72); border-radius: 4px; z-index: -1; }
  .trace.draw ~ .pmark { animation: fadein .5s ease both; animation-delay: calc(4.5s * var(--p, 0)); }
  @keyframes fadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .trace, .trace.draw { clip-path: none; animation: none; } .pen { display: none; } .pmark { opacity: 1; animation: none !important; }
    .rise, .specimen, .strata > div, .frame img { animation: none; } .frame { transition: none; }
  }

  /* 波形底下的说明（像图说） */
  .seis-cap { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; padding-top: 14px; padding-bottom: 22px; font-size: 13px; line-height: 1.6; color: var(--dark-muted); }
  .quake-chip { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; color: var(--dark-muted); text-decoration: none; }
  .quake-chip:hover { opacity: 1; } .quake-chip:hover .qc-place { color: var(--cyan); }
  .quake-chip strong { color: var(--gold); }
  .qc-place { color: var(--dark-text); transition: color .2s; }
  .qc-note { opacity: .8; flex: 1 1 320px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 0 rgba(0,200,210,.6); animation: pulse 2s infinite; }
  @keyframes pulse { to { box-shadow: 0 0 0 8px rgba(0,200,210,0); } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; }
    .specimen { max-width: 420px; width: 88%; justify-self: center; }
    .specimen-label { left: -10px; }
  }
  @media (max-width: 640px) {
    .specimen { max-width: 260px; width: 72%; }
    /* 照片变小了，标签也跟着缩：标题最多两行，不要把标本整个盖掉 */
    .specimen-label { bottom: 14px; max-width: 78%; padding: 8px 12px 7px; }
    .sl-cap { font-size: 14px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .sl-go { font-size: 12px; }
    .hero-inner { padding-top: 40px; gap: 28px; }
    .seis-cap { padding-top: 12px; }
    .qc-note { flex-basis: 100%; }
  }

  /* ---------- 最新视频：一大三小 ---------- */
  .vfeature { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 24px; align-items: stretch; }
  .vmore { display: flex; flex-direction: column; gap: 16px; }
  .vmore > :global(.vcard) { flex: 1 1 0; min-height: 120px; }
  @media (max-width: 900px) { .vfeature { grid-template-columns: 1fr; } }

  .note { color: var(--muted); margin: -12px 0 28px; }
  .rv { display: flex; } .rv > :global(*) { flex: 1; }
  /* 视频缩图滑过时慢慢放大 */
  .vfeature :global(.media) { overflow: hidden; }
  .vfeature :global(.media img) { transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .vfeature :global(.vcard:hover .media img) { transform: scale(1.06); }
  /* ---------- 全世界的金钉子 ---------- */
  .spikes-band { border-top: 1px solid var(--line); }
  .spikes-inner { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .spikes-text { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .spikes-text h2 { margin: 0; font-family: var(--font-cjk-serif); font-weight: 900; font-size: clamp(30px, 4vw, 40px); line-height: 1.25; }
  .spikes-text p { margin: 0; font-size: 17px; line-height: 1.8; color: var(--muted); text-wrap: pretty; }
  .spikes-map { display: block; border: 1px solid var(--line); border-radius: 14px; background: var(--darker); padding: clamp(12px, 2vw, 24px); transition: border-color .2s; }
  .spikes-map:hover { border-color: var(--gold); opacity: 1; }
  .spikes-map img { width: 100%; height: auto; }
  @media (max-width: 860px) { .spikes-inner { grid-template-columns: 1fr; } }
  .monitor { border-top: 1px solid #2D2414; border-bottom: 1px solid #2D2414; }
  .monitor-inner { display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .monitor-text { flex: 1 1 340px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .monitor-text h2 { margin: 0; font-family: var(--font-cjk-serif); font-weight: 900; line-height: 1.25; font-size: clamp(30px, 4vw, 38px); }
  .monitor-text p { margin: 0; font-size: 17px; line-height: 1.8; color: var(--muted); }
  .live { color: var(--cyan); }
  .monitor-list { flex: 2 1 480px; min-width: 0; }

  /* ---------- 你知道吗：标本标签卡 ---------- */
  .center { text-align: center; }
  .muted { color: var(--muted); margin: 10px 0 0; }
  .flip-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 24px; margin-top: 40px; text-align: left; }
  .flip { position: relative; min-height: 240px; border: 0; padding: 0; background: transparent; perspective: 1000px; color: var(--fg); text-align: left; }
  .face { position: absolute; inset: 0; border-radius: 6px; padding: 22px 24px; display: flex; flex-direction: column; gap: 16px; backface-visibility: hidden; -webkit-backface-visibility: hidden; transition: transform .6s; }
  .front { background: var(--card); border: 1px solid var(--line); box-shadow: 0 1px 0 var(--line), 0 12px 24px -18px rgba(31,26,16,.35); justify-content: space-between;
    /* 标签纸上的横线 */
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, rgba(138,100,0,.08) 31px 32px); background-position: 0 58px; }
  .flip:hover .front { border-color: var(--accent); }
  /* 问题卡：像从桌上拿起一张标签 */
  :global(html.js) .flip[data-reveal].in { transition: transform .35s cubic-bezier(.2,.7,.2,1), opacity .7s; }
  :global(html.js) .flip[data-reveal].in:hover, .flip:hover { transform: translateY(-6px) rotate(-.8deg); }
  :global(html.js) .flip[data-reveal].in:nth-child(2):hover, .flip:nth-child(2):hover { transform: translateY(-6px) rotate(.8deg); }
  @media (prefers-reduced-motion: reduce) { .flip:hover, :global(html.js) .flip[data-reveal].in:hover { transform: none; } }
  .label-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 10px; border-bottom: 2px solid var(--fg); font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .label-head .no { font-family: var(--font-serif); font-style: italic; font-size: 18px; letter-spacing: 0; color: var(--accent); text-transform: none; }
  .front .q { color: var(--fg); font-family: var(--font-cjk-serif); font-weight: 700; font-size: 23px; line-height: 1.45; flex: 1; display: flex; align-items: center; }
  .label-foot { display: flex; align-items: center; gap: 10px; color: var(--accent); font-size: 13px; font-weight: 700; }
  .back { background: var(--dark); color: var(--dark-text); border: 2px solid var(--gold); transform: rotateY(180deg); font-size: 16px; line-height: 1.75; justify-content: center; }
  .flip[aria-pressed="true"] .front { transform: rotateY(180deg); }
  .flip[aria-pressed="true"] .back { transform: rotateY(360deg); }
  @media (max-width: 640px) { .flip { min-height: 200px; } }

  .about { padding-bottom: 88px; }
  .about-card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: clamp(24px, 4vw, 40px); display: flex; flex-wrap: wrap; gap: 32px; align-items: center; }
  .about-card > div:last-child { flex: 1 1 380px; }
  .avatar { flex: 0 0 120px; height: 120px; border-radius: 50%; border: 2px solid #D9A60B; font-family: var(--font-display); font-weight: 700; font-size: 32px; overflow: hidden; }
  /* 关于页的照片：对准脸部、放大一点（照片是全身照） */
  .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; transform: scale(1.8); transform-origin: 43% 42%; }
  .about-card h2 { margin: 0 0 12px; font-family: var(--font-cjk-serif); font-weight: 900; font-size: 28px; }
  .about-card p { margin: 0 0 12px; font-size: 17px; line-height: 1.85; color: var(--paper-body); }
  .about-card a { font-weight: 700; display: inline-block; padding: 8px 0; }
</style>

<script>
  import { fetchQuakes, timeAgo } from '../lib/quakes';
  import { tracePath } from '../lib/trace';

  document.querySelectorAll<HTMLButtonElement>('.flip').forEach((b) =>
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))));

  // 照片：滑鼠移动时微微倾斜（触控萤幕、减少动态时不做）
  const pick = document.getElementById('hero-pick');
  const frame = pick?.querySelector<HTMLElement>('.frame');
  if (pick && frame && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    pick.addEventListener('pointermove', (e) => {
      const r = pick.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
      frame.style.setProperty('--rx', `${(x - .5) * 10}deg`);
      frame.style.setProperty('--ry', `${(.5 - y) * 10}deg`);
      frame.style.setProperty('--gx', `${x * 100}%`);
      frame.style.setProperty('--gy', `${y * 100}%`);
    });
    pick.addEventListener('pointerleave', () => { frame.style.removeProperty('--rx'); frame.style.removeProperty('--ry'); });
  }

  // 地层带的波形：网站生成时已经放进真实记录（data-real）；没有的话才用 USGS 最新 M4.5+ 的规模画示意波形
  (async () => {
    const svg = document.querySelector<SVGSVGElement>('.trace');
    const path = document.getElementById('trace-path');
    const chip = document.getElementById('quake-chip');
    if (!svg || !path || !chip) return;
    const lang = document.documentElement.lang.startsWith('zh') ? 'zh' : 'en';
    if (chip.dataset.real) {
      const q = JSON.parse(chip.dataset.real);
      document.getElementById('qc-mag')!.textContent = `M${q.mag.toFixed(1)}`;
      document.getElementById('qc-place')!.textContent = `${q.place} · ${timeAgo(q.time, lang)}`;
      chip.hidden = false;
      svg.classList.add('draw');
      return;
    }
    try {
      const [q] = await fetchQuakes('day45');
      if (!q) return;
      path.setAttribute('d', tracePath(q.mag));
      document.getElementById('qc-mag')!.textContent = `M${q.mag.toFixed(1)}`;
      document.getElementById('qc-place')!.textContent = `${q.place} · ${timeAgo(q.time, lang)}`;
      chip.hidden = false;
    } catch { /* 读不到就留着默认的示意波形 */ }
    svg.classList.add('draw');
  })();
</script>
