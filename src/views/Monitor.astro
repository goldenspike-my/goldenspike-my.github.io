---
import Base from '../layouts/Base.astro';
import { t, url, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const feeds = [['day45', 'pastDay45'], ['week45', 'pastWeek45'], ['day25', 'pastDay25']] as const;
const regions = [['global', 'global'], ['japan', 'japan'], ['seasia', 'seasia']] as const;
---
<Base lang={lang} title={t(lang, 'monitor')} active="monitor">
  <section class="sec-darker monitor-page">
    <div class="wrap">
      <nav class="tabs" aria-label={t(lang, 'monitor')}>
        <a class="chip active" href={url(lang, '/monitor')} aria-current="page">{t(lang, 'monitorTabLive')}</a>
        <a class="chip" href={url(lang, '/malaysia-quakes')}>{t(lang, 'monitorTabMalaysia')}</a>
      </nav>
      <div class="top">
        <div>
          <span class="kicker live">{t(lang, 'monitorKicker')}</span>
          <h1 class="page-title">{t(lang, 'monitorTitle')}</h1>
          <p class="sub">{t(lang, 'monitorText')}</p>
        </div>
        <div class="controls">
          <div class="chips" role="group" aria-label="Time range" id="feed-chips">
            {feeds.map(([k, label], i) => <button class="chip" type="button" data-feed={k} aria-pressed={i === 0 ? 'true' : 'false'}>{t(lang, label)}</button>)}
          </div>
          <div class="chips" role="group" aria-label="Region" id="region-chips">
            {regions.map(([k, label], i) => <button class="chip" type="button" data-region={k} aria-pressed={i === 0 ? 'true' : 'false'}>{t(lang, label)}</button>)}
          </div>
        </div>
      </div>

      <div class="panel" id="monitor" data-lang={lang} data-depth={t(lang, 'depth')} data-error={t(lang, 'loadError')}
        data-empty={t(lang, 'noQuakes')} data-loading={t(lang, 'loading')} data-count={t(lang, 'quakesCount')} data-updated={t(lang, 'lastUpdated')}
        data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
        <div class="map-box"><div id="map" role="region" aria-label="Earthquake map"></div></div>
        <div class="list-box">
          <div class="list-head"><strong id="count">–</strong><span id="updated"></span></div>
          <ul class="qlist" id="qlist" aria-live="polite"><li class="qstatus">{t(lang, 'loading')}</li></ul>
        </div>
      </div>

      <div class="legend" aria-label="Magnitude colours">
        <span><i style="background:#9FD8DC"></i>&lt; 4</span>
        <span><i style="background:#E6D27A"></i>4–5</span>
        <span><i style="background:#F2B90D"></i>5–6</span>
        <span><i style="background:#FF8A1F"></i>6–7</span>
        <span><i style="background:#FF4D2E"></i>7+</span>
        <span class="plate"><i></i>{t(lang, 'plateBoundary')}</span>
        <span class="src">{t(lang, 'dataSource')}</span>
      </div>
    </div>
  </section>
</Base>

<style>
  .monitor-page { padding: 40px 0 88px; }
  .tabs { display: flex; gap: 8px; margin-bottom: 22px; flex-wrap: wrap; }
  .live { color: var(--cyan); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 28px; }
  .top h1 { margin-top: 10px; }
  .sub { color: var(--muted); margin: 10px 0 0; max-width: 560px; }
  .controls { display: flex; flex-direction: column; gap: 10px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .panel { display: flex; flex-wrap: wrap; gap: 20px; }
  .map-box { position: relative; flex: 3 1 560px; min-width: 0; border-radius: 14px; background: #0C0A06; }   /* 圆角外框在 global.css 的 .map-box::after */
  #map { height: clamp(360px, 60vh, 600px); }
  .list-box { flex: 1 1 300px; min-width: 0; background: var(--dark); border: 1px solid var(--line); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; max-height: clamp(360px, 60vh, 600px); }
  .list-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid var(--line); font-size: 14px; color: var(--muted); }
  .list-head strong { color: var(--fg); font-size: 16px; }
  .list-box .qlist { overflow-y: auto; padding-right: 4px; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 16px; font-size: 13px; color: var(--muted); align-items: center; }
  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; }
  .legend .plate i { border-radius: 0; height: 0; width: 18px; border-top: 2px dashed var(--cyan); background: none; vertical-align: 3px; }
  .legend .src { margin-left: auto; }
</style>

<script>
  import { createMap, addPlates, maplibregl, escapeHtml, firstSymbolLayer } from '../lib/map';
  import { fetchQuakes, inRegion, magColor, quakeItemHtml, REGIONS, type FeedKey, type RegionKey, type Quake } from '../lib/quakes';

  const el = document.getElementById('monitor')!;
  const ds = el.dataset as Record<string, string>;
  const lang = ds.lang;
  const locale = lang === 'zh' ? 'zh-CN' : 'en-GB';
  const WORLD = { center: [170, 10] as [number, number], zoom: 1.2 };   // 太平洋放中间：环太平洋地震带看得最清楚

  const mapReady = createMap({ container: 'map', lang, ...WORLD, minZoom: 0.8 }).then(async (map) => {
    await addPlates(map, ds.base).catch(() => {});
    map.addSource('quakes', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    map.addLayer({
      id: 'quakes', type: 'circle', source: 'quakes',
      paint: {
        // 规模越大，圈越大（跟旧地图一样：半径 ≈ 0.55 × 规模²）
        'circle-radius': ['max', 4, ['*', 0.55, ['get', 'mag'], ['get', 'mag']]],
        'circle-color': ['get', 'color'], 'circle-opacity': 0.85,
        'circle-stroke-color': '#1A160C', 'circle-stroke-width': 1,
      },
      layout: { 'circle-sort-key': ['get', 'mag'] },   // 大的画在上面
    }, firstSymbolLayer(map));
    const popup = new maplibregl.Popup({ closeButton: true, maxWidth: '260px' });
    map.on('click', 'quakes', (e) => {
      const p = e.features![0].properties as any;
      popup.setLngLat((e.features![0].geometry as any).coordinates).setHTML(
        `<strong>M${Number(p.mag).toFixed(1)}</strong><br>${escapeHtml(p.place)}<br>${new Date(p.time).toLocaleString(locale, { timeZoneName: 'short' })}<br>${ds.depth} ${Math.round(p.depth)} km<br><a href="${escapeHtml(p.url)}" target="_blank" rel="noopener">USGS ↗</a>`,
      ).addTo(map);
    });
    map.on('mouseenter', 'quakes', () => { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'quakes', () => { map.getCanvas().style.cursor = ''; });
    return map;
  });

  let feed: FeedKey = 'day45';
  let region: RegionKey = 'global';
  const cache: Partial<Record<FeedKey, Quake[]>> = {};
  const list = document.getElementById('qlist')!;
  const count = document.getElementById('count')!;
  const updated = document.getElementById('updated')!;

  async function draw(quakes: Quake[]) {
    const shown = quakes.filter((q) => inRegion(q, region));
    count.textContent = `${shown.length} ${ds.count}`;
    list.innerHTML = shown.length
      ? shown.map((q) => quakeItemHtml(q, lang, ds.depth)).join('')
      : `<li class="qstatus">${ds.empty}</li>`;
    const map = await mapReady;
    (map.getSource('quakes') as any).setData({
      type: 'FeatureCollection',
      features: shown.map((q) => ({ type: 'Feature', geometry: { type: 'Point', coordinates: [q.lon, q.lat] },
        properties: { mag: q.mag, place: q.place, time: q.time, depth: q.depth, url: q.url, color: magColor(q.mag) } })),
    });
    const box = REGIONS[region];
    if (box) map.fitBounds([[box[1], box[0]], [box[3], box[2]]], { padding: 20, duration: 900 });
    else map.easeTo({ ...WORLD, duration: 900 });
  }

  async function load() {
    list.innerHTML = `<li class="qstatus">${ds.loading}</li>`;
    try {
      cache[feed] ??= await fetchQuakes(feed);
      await draw(cache[feed]!);
      updated.textContent = `${ds.updated} ${new Date().toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })}`;   // 加时区：马来西亚 GMT+8、日本 GMT+9 读者看得懂
    } catch {
      list.innerHTML = `<li class="qstatus">${ds.error}</li>`;
    }
  }

  function bindChips(groupId: string, onPick: (v: string) => void) {
    const chips = document.querySelectorAll<HTMLButtonElement>(`#${groupId} .chip`);
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      onPick((c.dataset.feed || c.dataset.region)!);
    }));
  }
  bindChips('feed-chips', (v) => { feed = v as FeedKey; load(); });
  bindChips('region-chips', (v) => { region = v as RegionKey; load(); });
  load();
</script>
