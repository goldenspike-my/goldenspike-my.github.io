---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { switchLangPath, asset, type Lang } from '../lib/i18n';
interface Props { lang: Lang; title?: string; description?: string; active?: string; image?: string }
const { lang, title, description, active, image } = Astro.props;
const siteName = lang === 'zh' ? '金釘子 GoldenSpike' : 'GoldenSpike 金釘子';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const desc = description || (lang === 'zh' ? '地质与地震科普，加上京都研究生活与旅行。' : 'Geology and seismology explained simply, plus life and travel from Kyoto.');
const path = Astro.url.pathname;
const ogImage = image ? new URL(asset(image), Astro.site).href : undefined;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
  <link rel="alternate" hreflang="zh-Hans" href={new URL(switchLangPath(path, 'zh'), Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(switchLangPath(path, 'en'), Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Manrope:wght@400;500;700&family=Space+Grotesk:wght@500;700&family=Noto+Serif+SC:wght@500;700;900&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <Nav lang={lang} active={active} />
  <main><slot /></main>
  <Footer lang={lang} />
</body>
</html>
